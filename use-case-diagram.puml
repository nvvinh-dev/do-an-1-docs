@startuml SmartRent_UseCase_Phase1
' Sơ đồ Use Case — Phase 1
' Phạm vi: BP-01, BP-02, BP-03, BP-04, BP-06, BP-07, BP-10
' Các use case thuộc Phase 2 và Phase 3 không có trong sơ đồ này.
' Ẩn tin vi phạm (BP-03 A1) thuộc Phase 2, làm cùng khiếu nại BP-13.

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor "Khách truy cập" as Guest
actor "Người thuê" as Tenant
actor "Chủ trọ" as Landlord
actor "Quản trị viên" as Admin

Guest <|-- Tenant

rectangle "Hệ thống SmartRent" {

  package "Tài khoản và phân quyền" {
    usecase "Đăng ký tài khoản" as UC01
    usecase "Đăng nhập" as UC02
    usecase "Đổi mật khẩu" as UC03
    usecase "Quên mật khẩu" as UC04
    usecase "Cập nhật thông tin cá nhân" as UC45
    usecase "Nộp hồ sơ đăng ký Chủ trọ" as UC05
    usecase "Duyệt hồ sơ Chủ trọ" as UC06
    usecase "Từ chối hồ sơ Chủ trọ" as UC07
    usecase "Khóa / mở khóa tài khoản" as UC08
  }

  package "Khu trọ và phòng trọ" {
    usecase "Quản lý khu trọ" as UC09
    usecase "Quản lý phòng trọ" as UC10
    usecase "Bật / tắt hiển thị tin" as UC11
    usecase "Lưu trữ phòng / khu trọ" as UC12
  }

  package "Tìm kiếm" {
    usecase "Tìm kiếm phòng bằng bộ lọc" as UC14
    usecase "Xem chi tiết phòng" as UC15
  }

  package "Yêu cầu thuê và hợp đồng" {
    usecase "Gửi yêu cầu thuê" as UC16
    usecase "Hủy yêu cầu thuê" as UC17
    usecase "Duyệt yêu cầu thuê" as UC18
    usecase "Từ chối yêu cầu thuê" as UC19
    usecase "Lập hợp đồng" as UC20
    usecase "Xác nhận điều khoản hợp đồng" as UC21
    usecase "Xác nhận đã nhận tiền cọc" as UC22
    usecase "Tự từ chối các yêu cầu\ncòn lại của cùng phòng" as UC23
    usecase "Hủy hợp đồng\ntrước ngày bắt đầu" as UC41
    usecase "Yêu cầu chỉnh sửa hợp đồng" as UC44
  }

  package "Hóa đơn và thanh toán" {
    usecase "Chốt chỉ số điện nước" as UC24
    usecase "Phát hành hóa đơn" as UC25
    usecase "Xem hóa đơn" as UC26
    usecase "Báo đã thanh toán\nkèm minh chứng" as UC27
    usecase "Xác nhận đã thu tiền" as UC28
    usecase "Từ chối xác nhận thanh toán" as UC29
    usecase "Điều chỉnh sai sót\nhóa đơn kỳ trước" as UC30
    usecase "Sửa hóa đơn\nchưa thanh toán" as UC42
    usecase "Hủy hóa đơn\nchưa thanh toán" as UC43
    usecase "Khai báo tài khoản\nngân hàng nhận tiền" as UC39
    usecase "Xem mã VietQR\nđể chuyển khoản" as UC40
  }

  package "Chấm dứt hợp đồng" {
    usecase "Gửi / rút thông báo\ntrả phòng" as UC31
    usecase "Lập hóa đơn thanh lý" as UC32
    usecase "Xác nhận bảng thanh lý" as UC33
    usecase "Hoàn tất thanh lý\nvà tất toán cọc" as UC34
    usecase "Ghi nhận hoàn cọc\nkhi hợp đồng bị hủy" as UC46
  }

  package "Thông báo, nhật ký, thống kê" {
    usecase "Xem thông báo" as UC35
    usecase "Xem dashboard" as UC36
    usecase "Tra cứu nhật ký hệ thống" as UC37
    usecase "Ghi nhật ký hệ thống" as UC38
  }
}

